# Bizapp — Environment Configuration (Template)
# Copy to .env.local for local development. DO NOT commit production keys.

# Supabase API URL and Anon Key (safe for client-side bundle)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# Note: The service-role key must NEVER be placed in client environment files.
